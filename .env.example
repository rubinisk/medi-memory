# =====================================================================
#  MediMemory configuration. Copy this file to ".env" (setup.bat does it)
#  and fill in your keys. NEVER commit .env or put keys in frontend code.
# =====================================================================

# --- Database --------------------------------------------------------
# Leave empty to use SQLite (backend/medimemory.db). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://medimemory:medimemory@localhost:5432/medimemory
DATABASE_URL=

# --- Security --------------------------------------------------------
# Long random string. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- ElevenLabs (voice) ----------------------------------------------
# Get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Default voice ("Rachel" premade). Users can pick another voice in Settings.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- LLM (optional but recommended) ----------------------------------
# Any OpenAI-compatible chat completions API. Without a key the assistant
# still works: it quotes the relevant parts of the records directly.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Embeddings: "local" (offline, default) or "openai" (uses LLM_API_KEY + LLM_BASE_URL)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# --- OCR (optional) --------------------------------------------------
# Needed only for scanned PDFs and photos. On Windows install Tesseract
# (https://github.com/UB-Mannheim/tesseract/wiki) and point to the exe:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Files & retrieval -----------------------------------------------
MAX_UPLOAD_MB=10
RAG_TOP_K=5
RAG_MIN_SCORE=0.12
